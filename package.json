{
  "name": "dark-fantasy-settlement",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dark Fantasy Settlement - a grim settlement builder with a hero roster, for the web",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "prettier": "3.9.9",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
